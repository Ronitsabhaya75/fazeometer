# Copy to server/.env (the server reads it). Everything has a working default except the optional keys.

PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://faze:faze@localhost:55432/faze
MONGO_URL=mongodb://localhost:47017
REDIS_URL=redis://localhost:56379

JWT_SECRET=change-me
CODE_SECRET=change-me-too

# One stream "minute" in milliseconds. 60000 is real time. 10000 makes a demo stream 6x faster.
MINUTE_MS=10000
# Enables the fast-forward and demo helpers. Never set in production.
DEMO_MODE=1

# Optional. Without these the app uses a mock checkout, SQL ranking and a mock call room.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# YouTube Data API v3 key: fetches real titles and thumbnails for videos.
YOUTUBE_API_KEY=
